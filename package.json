{
  "name": "fermi",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "web": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "format": "pnpm --filter web format && cd contracts && forge fmt",
    "format:check": "pnpm --filter web format:check && cd contracts && forge fmt --check",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test",
    "paper:pdf": "./docs/pdf/build.sh"
  }
}
