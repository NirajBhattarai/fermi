{
  "version": 6,
  "randomSeed": "fermidirac10",
  "graph": {
    "viewport": {
      "xmin": 3,
      "ymin": 8.4,
      "xmax": 41,
      "ymax": 11.2
    },
    "xAxisLabel": "reserve of the coin being dumped",
    "yAxisLabel": "reserve of each other coin",
    "squareAxes": false,
    "showGrid": true
  },
  "expressions": {
    "list": [
      {
        "type": "text",
        "id": "title",
        "text": "10 stablecoins in one pool, each starting at x_m. Fermi-Dirac (green) vs flat band (blue dashed). One coin depegs and is dumped in (horizontal axis); the other 9 are drained equally (vertical axis: reserve of EACH of the 9). Green stops at the red dashed line, so the total paid out is capped near c - x_m. Blue keeps falling. Drag x_r, c, T."
      },
      {
        "type": "folder",
        "id": "params",
        "title": "Parameters",
        "collapsed": false
      },
      {
        "type": "expression",
        "id": "n",
        "folderId": "params",
        "color": "#000000",
        "latex": "n=10",
        "slider": {
          "hardMin": true,
          "hardMax": true,
          "min": "2",
          "max": "10",
          "step": "1"
        }
      },
      {
        "type": "expression",
        "id": "xm",
        "folderId": "params",
        "color": "#000000",
        "latex": "x_{m}=10",
        "slider": {
          "hardMin": true,
          "hardMax": true,
          "min": "8",
          "max": "12",
          "step": "0.5"
        }
      },
      {
        "type": "expression",
        "id": "c",
        "folderId": "params",
        "color": "#26a269",
        "latex": "c=13",
        "slider": {
          "hardMin": true,
          "hardMax": true,
          "min": "x_{m}+0.5",
          "max": "x_{m}+8",
          "step": "0.1"
        }
      },
      {
        "type": "expression",
        "id": "T",
        "folderId": "params",
        "color": "#26a269",
        "latex": "T=0.3",
        "slider": {
          "hardMin": true,
          "hardMax": true,
          "min": "0.1",
          "max": "2",
          "step": "0.05"
        }
      },
      {
        "type": "folder",
        "id": "math",
        "title": "Fermi-Dirac: f, its inverse g, its slope s",
        "collapsed": false
      },
      {
        "type": "expression",
        "id": "f",
        "folderId": "math",
        "color": "#26a269",
        "hidden": true,
        "latex": "f\\left(x\\right)=-T\\ln\\left(1+e^{\\frac{c-x}{T}}\\right)"
      },
      {
        "type": "expression",
        "id": "g",
        "folderId": "math",
        "color": "#26a269",
        "hidden": true,
        "latex": "g\\left(u\\right)=c-T\\ln\\left(e^{\\frac{-u}{T}}-1\\right)"
      },
      {
        "type": "expression",
        "id": "s",
        "folderId": "math",
        "color": "#26a269",
        "hidden": true,
        "latex": "s\\left(x\\right)=\\frac{1}{1+e^{\\frac{x-c}{T}}}"
      },
      {
        "type": "expression",
        "id": "h",
        "folderId": "math",
        "color": "#26a269",
        "hidden": true,
        "latex": "h\\left(x,N\\right)=g\\left(\\frac{Nf\\left(x_{m}\\right)-f\\left(x\\right)}{N-1}\\right)"
      },
      {
        "type": "folder",
        "id": "curve",
        "title": "Fermi-Dirac curve",
        "collapsed": false
      },
      {
        "type": "expression",
        "id": "fdcurve",
        "folderId": "curve",
        "color": "#26a269",
        "lineWidth": "5",
        "latex": "y=h\\left(x,n\\right)"
      },
      {
        "type": "expression",
        "id": "capline",
        "folderId": "curve",
        "color": "#26a269",
        "lineStyle": "DOTTED",
        "lineWidth": "2.5",
        "latex": "x=c"
      },
      {
        "type": "expression",
        "id": "lossfloor",
        "folderId": "curve",
        "color": "#c01c28",
        "lineStyle": "DASHED",
        "lineWidth": "2",
        "latex": "y=g\\left(\\frac{nf\\left(x_{m}\\right)}{n-1}\\right)"
      },
      {
        "type": "expression",
        "id": "peg",
        "folderId": "curve",
        "color": "#26a269",
        "latex": "\\left(x_{m},x_{m}\\right)",
        "pointSize": "14",
        "label": "peg",
        "showLabel": true,
        "labelOrientation": "right"
      },
      {
        "type": "expression",
        "id": "cappoint",
        "folderId": "curve",
        "color": "#26a269",
        "latex": "\\left(c,h\\left(c,n\\right)\\right)",
        "pointSize": "12",
        "label": "cap, price about 0.5",
        "showLabel": true,
        "labelOrientation": "left"
      },
      {
        "type": "folder",
        "id": "readout",
        "title": "Swap readout",
        "collapsed": false
      },
      {
        "type": "expression",
        "id": "xr",
        "folderId": "readout",
        "color": "#c01c28",
        "latex": "x_{r}=25",
        "slider": {
          "hardMin": true,
          "hardMax": true,
          "min": "x_{m}",
          "max": "40",
          "step": "0.05"
        }
      },
      {
        "type": "expression",
        "id": "yr",
        "folderId": "readout",
        "color": "#c01c28",
        "latex": "y_{r}=h\\left(x_{r},n\\right)"
      },
      {
        "type": "expression",
        "id": "price",
        "folderId": "readout",
        "color": "#c01c28",
        "latex": "p=\\frac{s\\left(x_{r}\\right)}{s\\left(y_{r}\\right)}"
      },
      {
        "type": "expression",
        "id": "paid",
        "folderId": "readout",
        "color": "#c01c28",
        "latex": "L=\\left(n-1\\right)\\left(x_{m}-y_{r}\\right)"
      },
      {
        "type": "expression",
        "id": "maxloss",
        "folderId": "readout",
        "color": "#c01c28",
        "latex": "L_{max}=\\left(n-1\\right)\\left(x_{m}-g\\left(\\frac{nf\\left(x_{m}\\right)}{n-1}\\right)\\right)"
      },
      {
        "type": "expression",
        "id": "trader",
        "folderId": "readout",
        "color": "#c01c28",
        "latex": "\\left(x_{r},y_{r}\\right)",
        "pointSize": "16",
        "label": "price = ${p}, good coins paid out = ${L}",
        "showLabel": true,
        "labelOrientation": "above"
      },
      {
        "type": "folder",
        "id": "compare",
        "title": "Flat band, same peg and n",
        "collapsed": false
      },
      {
        "type": "expression",
        "id": "w",
        "folderId": "compare",
        "color": "#1a5fb4",
        "latex": "w=2",
        "slider": {
          "hardMin": true,
          "hardMax": true,
          "min": "0.4",
          "max": "6",
          "step": "0.1"
        }
      },
      {
        "type": "expression",
        "id": "v",
        "folderId": "compare",
        "color": "#1a5fb4",
        "latex": "v=3",
        "slider": {
          "hardMin": true,
          "hardMax": true,
          "min": "0.5",
          "max": "8",
          "step": "0.1"
        }
      },
      {
        "type": "expression",
        "id": "fb",
        "folderId": "compare",
        "color": "#1a5fb4",
        "hidden": true,
        "latex": "f_{b}\\left(x\\right)=\\left\\{x<x_{m}-w:x_{m}-w+v\\ln\\left(\\frac{x-x_{m}+w+v}{v}\\right),x\\le x_{m}+w:x,x_{m}+w+v\\ln\\left(\\frac{x-x_{m}-w+v}{v}\\right)\\right\\}"
      },
      {
        "type": "expression",
        "id": "gb",
        "folderId": "compare",
        "color": "#1a5fb4",
        "hidden": true,
        "latex": "g_{b}\\left(u\\right)=\\left\\{u<x_{m}-w:x_{m}-w-v+ve^{\\frac{u-x_{m}+w}{v}},u\\le x_{m}+w:u,x_{m}+w-v+ve^{\\frac{u-x_{m}-w}{v}}\\right\\}"
      },
      {
        "type": "expression",
        "id": "hb",
        "folderId": "compare",
        "color": "#1a5fb4",
        "hidden": true,
        "latex": "h_{b}\\left(x,N\\right)=g_{b}\\left(\\frac{Nx_{m}-f_{b}\\left(x\\right)}{N-1}\\right)"
      },
      {
        "type": "expression",
        "id": "fbcurve",
        "folderId": "compare",
        "color": "#1a5fb4",
        "lineStyle": "DASHED",
        "lineWidth": "3",
        "latex": "y=h_{b}\\left(x,n\\right)\\left\\{x>x_{m}-w-v\\right\\}"
      },
      {
        "type": "expression",
        "id": "fbloss",
        "folderId": "compare",
        "color": "#1a5fb4",
        "latex": "L_{b}=\\left(n-1\\right)\\left(x_{m}-h_{b}\\left(x_{r},n\\right)\\right)"
      },
      {
        "type": "expression",
        "id": "fbpoint",
        "folderId": "compare",
        "color": "#1a5fb4",
        "latex": "\\left(x_{r},h_{b}\\left(x_{r},n\\right)\\right)",
        "pointSize": "12",
        "label": "flat band paid out = ${L_b}",
        "showLabel": true,
        "labelOrientation": "below"
      }
    ]
  }
}